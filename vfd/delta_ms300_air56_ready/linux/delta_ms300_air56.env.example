# Delta MS300 AIR56 monitor service environment.
# Copy to /etc/mic_theory/delta_ms300_air56.env and edit for the real bench.
MIC_THEORY_ROOT=/opt/mic_theory
CONFIG=/opt/mic_theory/config/vfd_delta_ms300_air56.json
MODE=monitor
PERIOD_S=0.5
CSV_LOG=/var/log/mic_theory/delta_ms300_air56_monitor.csv
# The JSON config owns serial port, baud, parity, stop bits, slave id, and safety gates.
